# ═══════════════════════════════════════════════════════════════════════════
# ✅ SECURITY CRITICAL - Set these values before production deployment
# ═══════════════════════════════════════════════════════════════════════════

# JWT Secret - Generate with: openssl rand -base64 32
# ⚠️ NEVER use the default value in production!
# Change this immediately: openssl rand -base64 32
JWT_SECRET=generate_a_random_secret_at_least_32_chars

# ═══════════════════════════════════════════════════════════════════════════
# Database
# ═══════════════════════════════════════════════════════════════════════════

MONGODB_URI=mongodb://localhost:27017
DB_NAME=hangouttourist

# ═══════════════════════════════════════════════════════════════════════════
# Redis Cache
# ═══════════════════════════════════════════════════════════════════════════

REDIS_URL=redis://localhost:6379

# ═══════════════════════════════════════════════════════════════════════════
# Server Configuration
# ═══════════════════════════════════════════════════════════════════════════

PORT=5000
NODE_ENV=development
# NODE_ENV=production  # Use in production with HTTPS

# ═══════════════════════════════════════════════════════════════════════════
# Frontend
# ═══════════════════════════════════════════════════════════════════════════

CLIENT_URL=http://localhost:5173
# CLIENT_URL=https://yourdomain.com  # Use HTTPS in production

# ═══════════════════════════════════════════════════════════════════════════
# SSL Commerz Payment Gateway
# Get credentials from: https://merchant.sslcommerz.com/
# ═══════════════════════════════════════════════════════════════════════════

SSLCOMMERZ_STORE_ID=your_store_id_from_sslcommerz
SSLCOMMERZ_STORE_PASSWORD=your_store_password_from_sslcommerz
BACKEND_URL=http://localhost:5000
# BACKEND_URL=https://api.yourdomain.com  # Use HTTPS in production

# ═══════════════════════════════════════════════════════════════════════════
# Email Configuration (Optional)
# ═══════════════════════════════════════════════════════════════════════════

SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# ═══════════════════════════════════════════════════════════════════════════
# Security Notes
# ═══════════════════════════════════════════════════════════════════════════

# 1. NEVER commit real .env file to git
# 2. Change JWT_SECRET immediately - generate new value:
#    openssl rand -base64 32
# 
# 3. In production:
#    - Set NODE_ENV=production
#    - Use HTTPS URLs (https://)
#    - Use strong JWT_SECRET
#    - Set database passwords
#    - Enable CORS only for your domain
#
# 4. Rate limiting is enabled in production
# 5. Security headers (Helmet) are enabled
# 6. Input sanitization is enabled
